library(spatstat)
install.packages("spatstat")
library(spatstat)
set.seed(1)
lambda <- 100
# Step 1: draw the random number of points
n <- rpois(1, lambda)     # which function draws a Poisson random number?
# Step 2: place the points uniformly in the unit square
x <- runif(n)
y <- runif(n)
plot(x, y, asp = 1)
# Compare with the built-in version
X <- rpoispp(lambda)
plot(X)
